class Solution:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next


# Create nodes
node1 = Solution(1)
node2 = Solution(2)
node3 = Solution(3)

# Connect nodes
node1.next = node2
node2.next = node3
node3.next = node1  # Create cycle

head = node1


def detectCycle(head):
    slow = head
    fast = head

    # Step 1: Detect cycle
    while fast and fast.next:
        slow = slow.next
        fast = fast.next.next

        if slow == fast:

            # Step 2: Find cycle starting point
            slow = head

            while slow != fast:
                slow = slow.next
                fast = fast.next

            return slow

    return None


# Call the function
result = detectCycle(head)

# Display the result
if result:
    print("Cycle starts at node:", result.val)
else:
    print("No cycle found")
