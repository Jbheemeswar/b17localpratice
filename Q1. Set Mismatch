
class Solution:
    def findErrorNums(self, nums: list[int]) -> list[int]:
        seen = set()
        duplicate = -1

        for num in nums:
            if num in seen:
                duplicate = num
            seen.add(num)

        missing = -1

        for num in range(1, len(nums) + 1):
            if num not in seen:
                missing = num
                break

        return [duplicate, missing]
